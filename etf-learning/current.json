        "CW8.PA"
      ],
      "translations": {
        "fr": {
          "title": "Où vont les 0,38% de frais ?",
          "body": "Pas de facture reçue ! Les frais sont prélevés directement et de façon transparente au jour le jour dans la valeur liquidative de l'ETF."
        },
        "en": {
          "title": "Where do the 0.38% fees go?",
          "body": "No bill to pay! Fees are deducted directly and transparently on a daily basis from the ETF's net asset value."
        }
      },
      "status": "active",
      "version": 1
    },
